NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://abp:abp@localhost:5432/abp?schema=public
TEST_DATABASE_URL=postgresql://abp:abp@localhost:5432/abp_test?schema=public
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000/api/v1
ABP_AUTH_MODE=local-stub
ABP_DEPLOYMENT_MODE=pre-authorization
ABP_PLATFORM_PROOF_ENABLED=false
ABP_WORKER_ID=local-worker
ABP_WORKER_BATCH_SIZE=10
ABP_WORKER_POLL_DELAY_MS=1000
ABP_WORKER_LEASE_SECONDS=30
ABP_WORKER_RETRY_BASE_MS=1000
ABP_WORKER_RETRY_MAX_MS=60000
ABP_WORKER_HEALTH_PORT=3001
ABP_ERP_SYNC_SCAN_INTERVAL_MS=5000
ABP_ERP_SYNC_BATCH_SIZE=25
ABP_ALLOW_DEMO_SEED=true
ABP_EXTERNAL_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_BASE_URL=https://api.openai.com/v1

# Email (Outlook). Development sends everything to Mailpit (localhost:8025).
# Production: GRAPH for Microsoft 365, SMTP for the company Exchange server.
# See docs/guides/email-and-backups.md.
ABP_MAIL_PROVIDER=SMTP
ABP_MAIL_SENDER=crm@acrow.local
ABP_MAIL_FROM_NAME=ACROW Building Products
ABP_MAIL_SMTP_HOST=mailpit
ABP_MAIL_SMTP_PORT=1025
ABP_MAIL_SMTP_SECURE=false
ABP_MAIL_SMTP_USER=
ABP_MAIL_SMTP_PASSWORD=
ABP_MAIL_GRAPH_TENANT_ID=
ABP_MAIL_GRAPH_CLIENT_ID=
ABP_MAIL_GRAPH_CLIENT_SECRET=
# The address people open the system on; used in links inside emails.
ABP_PUBLIC_APP_URL=http://localhost:8080

# Backups: nightly at this hour (Cairo), kept 14 daily and 6 monthly.
ABP_BACKUP_DIR=./backups
ABP_BACKUP_HOUR=2
ABP_BACKUP_KEEP_DAILY=14
ABP_BACKUP_KEEP_MONTHLY=6
