NODE_ENV=production
ABP_DEPLOYMENT_MODE=self-hosted
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_SECRET
DATABASE_URL=postgresql://abp:CHANGE_ME@db:5432/abp?schema=public
ABP_ALLOWED_ORIGINS=https://abp-commercial.local
ABP_SESSION_COOKIE_SECURE=true
ABP_LOCAL_SECRET_DIR=/run/secrets/abp
ABP_MFA_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_SECRET
ABP_LOCAL_OBJECT_ROOT=/workspace/storage
ABP_TEST_AUTH_ENABLED=false
ABP_DEMO_SEED_ENABLED=false
ABP_EXTERNAL_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_BASE_URL=https://api.openai.com/v1
ABP_LOG_LEVEL=info
ABP_BACKUP_ROOT=/backups
ABP_MAX_FAILED_LOGIN_ATTEMPTS=5
ABP_LOCKOUT_MINUTES=15
ABP_ARGON2_MEMORY_KIB=65536
ABP_ARGON2_TIME_COST=3
ABP_ARGON2_PARALLELISM=1
ABP_LOCAL_ADMIN_BOOTSTRAP_ENABLED=false

# Store secrets in a protected local file or OS secret store. Do not commit this file.
# The production profile intentionally has no Azure, Entra, cloud, paid SaaS or public Internet requirement.

# --- Email (Outlook) -----------------------------------------------------
# Microsoft 365: ABP_MAIL_PROVIDER=GRAPH with an app registration allowed to
# send as ABP_MAIL_SENDER (Mail.Send application permission).
# Company Exchange server: ABP_MAIL_PROVIDER=SMTP with host, port and login.
# Leave ABP_MAIL_PROVIDER empty to keep email off.
ABP_MAIL_PROVIDER=
ABP_MAIL_SENDER=
ABP_MAIL_FROM_NAME=ACROW Building Products
ABP_MAIL_GRAPH_TENANT_ID=
ABP_MAIL_GRAPH_CLIENT_ID=
ABP_MAIL_GRAPH_CLIENT_SECRET=
ABP_MAIL_SMTP_HOST=
ABP_MAIL_SMTP_PORT=587
ABP_MAIL_SMTP_SECURE=false
ABP_MAIL_SMTP_USER=
ABP_MAIL_SMTP_PASSWORD=
# The address people open the system at; links in emails point here.
ABP_PUBLIC_APP_URL=https://abp-commercial.local

# --- Backups -------------------------------------------------------------
# Hour of the nightly backup (Cairo time), where backups are kept, and a
# second location on another disk or network share.
ABP_BACKUP_HOUR=2
ABP_BACKUP_DIR=./backups
ABP_BACKUP_OFFSITE_DIR=
ABP_BACKUP_KEEP_DAILY=14
ABP_BACKUP_KEEP_MONTHLY=6
