{
  "name": "@abp/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "corepack pnpm --filter @abp/database build",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "preproof:workflows": "corepack pnpm --filter @abp/database build && tsc -p tsconfig.json",
    "proof:workflows": "node dist/workflow-proof-cli.js"
  },
  "dependencies": {
    "@abp/contracts": "workspace:*",
    "@abp/database": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "exceljs": "4.4.0",
    "nodemailer": "^10.0.15",
    "playwright": "1.55.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vitest": "^4.0.2"
  }
}
