/// The order the CRM books from an accepted quotation. ERP orders remain the
/// imported, read-only facts; this is the CRM's own record of what was agreed,
/// carried from confirmation to hand-over, and linked to the ERP order once
/// the ERP has it.
model CustomerOrder {
  id                    String                  @id @default(uuid()) @map("customer_order_id") @db.Uuid
  orderRef              String                  @unique @default(dbgenerated("('SO-'::text || lpad((nextval('customer_order_ref_seq'::regclass))::text, 6, '0'::text))")) @map("order_ref")
  quotationId           String                  @unique @map("quotation_id") @db.Uuid
  accountId             String                  @map("account_id") @db.Uuid
  opportunityId         String?                 @map("opportunity_id") @db.Uuid
  erpOrderId            String?                 @map("erp_order_id") @db.Uuid
  countryCode           String                  @map("country_code") @db.Char(2)
  currencyCode          String                  @map("currency_code") @db.Char(3)
  statusCode            String                  @default("DRAFT") @map("status_code")
  customerPoNumber      String?                 @map("customer_po_number")
  requestedDeliveryDate DateTime?               @map("requested_delivery_date") @db.Date
  deliveryTerms         String?                 @map("delivery_terms")
  deliveryPoint         String?                 @map("delivery_point")
  notes                 String?
  subtotalAmount        Decimal                 @map("subtotal_amount") @db.Decimal(18, 4)
  adjustmentAmount      Decimal                 @default(0) @map("adjustment_amount") @db.Decimal(18, 4)
  vatRate               Decimal                 @default(0) @map("vat_rate") @db.Decimal(9, 6)
  taxAmount             Decimal                 @map("tax_amount") @db.Decimal(18, 4)
  totalAmount           Decimal                 @map("total_amount") @db.Decimal(18, 4)
  paymentScheduleJsonb  Json?                   @map("payment_schedule_jsonb")
  paymentTermsText      String?                 @map("payment_terms_text")
  amendmentNo           Int                     @default(0) @map("amendment_no")
  ownerUserId           String                  @map("owner_user_id") @db.Uuid
  createdByUserId       String                  @map("created_by_user_id") @db.Uuid
  confirmedAt           DateTime?               @map("confirmed_at") @db.Timestamptz(6)
  confirmedByUserId     String?                 @map("confirmed_by_user_id") @db.Uuid
  handedOverAt          DateTime?               @map("handed_over_at") @db.Timestamptz(6)
  handedOverByUserId    String?                 @map("handed_over_by_user_id") @db.Uuid
  closedAt              DateTime?               @map("closed_at") @db.Timestamptz(6)
  closedByUserId        String?                 @map("closed_by_user_id") @db.Uuid
  cancelledAt           DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId     String?                 @map("cancelled_by_user_id") @db.Uuid
  cancelReason          String?                 @map("cancel_reason")
  rowVersion            BigInt                  @default(1) @map("row_version")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  account               Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lines                 CustomerOrderLine[]
  events                CustomerOrderEvent[]
  installments          ReceivableInstallment[]
  workOrders            WorkOrder[]

  @@index([accountId, createdAt(sort: Desc)])
  @@index([countryCode, statusCode, updatedAt(sort: Desc)])
  @@map("customer_orders")
}

model CustomerOrderLine {
  id              String        @id @default(uuid()) @map("customer_order_line_id") @db.Uuid
