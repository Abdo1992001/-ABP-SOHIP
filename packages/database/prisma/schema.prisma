  referenceBoardLengthMm   Decimal?  @map("reference_board_length_mm") @db.Decimal(12, 3)
  defaultDiscountPct       Decimal?  @map("default_discount_pct") @db.Decimal(5, 2)
  /// MASTER SETTINGS "Max Panel Width (mm)" -- how wide one panel may be cut.
  maxPanelWidthMm          Decimal?  @map("max_panel_width_mm") @db.Decimal(12, 3)
  /// MASTER SETTINGS "Max Panel Length (mm)" -- how tall one lift may be.
  maxPanelLengthMm         Decimal?  @map("max_panel_length_mm") @db.Decimal(12, 3)
  /// MASTER SETTINGS "Column / Core / Wall Height (mm)".
  defaultColumnHeightMm    Decimal?  @map("default_column_height_mm") @db.Decimal(12, 3)
  /// MASTER SETTINGS "Regular Column Closure Allowance (mm)": the lap the two
  /// closing panels of a rectangular column gain over their neighbours, so the
  /// faces are A / B / A+allowance / B+allowance. See column-faces.ts.
  columnClosureAllowanceMm Decimal?  @map("column_closure_allowance_mm") @db.Decimal(12, 3)
