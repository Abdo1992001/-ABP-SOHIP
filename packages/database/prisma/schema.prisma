/// CR-001 Shipment Tracking is an execution projection over imported ERP facts.
model Shipment {
  id                    String    @id @default(uuid()) @map("shipment_id") @db.Uuid
  shipmentRef           String    @unique @default(dbgenerated("('SHP-'::text || lpad((nextval('shipment_ref_seq'::regclass))::text, 8, '0'::text))")) @map("shipment_ref")
  erpOrderId            String?   @map("erp_order_id") @db.Uuid
  countryCode           String    @map("country_code") @db.Char(2)
  milestoneCode         String    @default("READY_FOR_DELIVERY") @map("milestone_code")
  /// The CRM order this shipment delivers; an ERP export shipment has only erpOrderId.
  customerOrderId       String?   @map("customer_order_id") @db.Uuid
  /// LOCAL_TRUCK or SEA_CONTAINER: which milestones the shipment runs through.
  transportModeCode     String    @default("SEA_CONTAINER") @map("transport_mode_code")
  plannedDispatchDate   DateTime? @map("planned_dispatch_date") @db.Date
  expectedDeliveryDate  DateTime? @map("expected_delivery_date") @db.Date
  /// Units from the Cargo Loader: [{ typeCode, count }], total weight, a note.
  loadPlan              Json?     @map("load_plan_jsonb")
  vehicleRef            String?   @map("vehicle_ref")
  containerNo           String?   @map("container_no")
  sealNo                String?   @map("seal_no")
  driverName            String?   @map("driver_name")
  driverPhone           String?   @map("driver_phone")
  dispatchedAt          DateTime? @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt           DateTime? @map("delivered_at") @db.Timestamptz(6)
  receivedByName        String?   @map("received_by_name")
  deliveryConditionCode String?   @map("delivery_condition_code")
  deliveryNotes         String?   @map("delivery_notes")
  podReceivedAt         DateTime? @map("pod_received_at") @db.Timestamptz(6)
  podReference          String?   @map("pod_reference")
  podDocumentId         String?   @map("pod_document_id") @db.Uuid
  blDate                DateTime? @map("bl_date") @db.Date
  portOfDischarge       String?   @map("port_of_discharge")
