/// A product photo. It belongs to the product, never to a quotation: the same
/// board appears on hundreds of quotations and storing the bytes on each one
/// would duplicate it hundreds of times. A quotation line points at the image
/// it used, so re-uploading a photo cannot rewrite a document already sent.
model ProductImage {
  id               String          @id @default(uuid()) @map("product_image_id") @db.Uuid
  productId        String          @map("product_id") @db.Uuid
  storageKey       String          @unique @map("storage_key")
  fileName         String          @map("file_name")
  contentType      String          @map("content_type")
  sizeBytes        Int             @map("size_bytes")
  sha256           String
  isPrimary        Boolean         @default(true) @map("is_primary")
  uploadedByUserId String          @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedBy       AppUser         @relation("ProductImageUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  quotationLines   QuotationLine[]

  @@index([productId, isPrimary])
  @@map("product_images")
}

