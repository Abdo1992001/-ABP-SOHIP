}

model CustomerOrderEvent {
  id              String        @id @default(uuid()) @map("customer_order_event_id") @db.Uuid
  customerOrderId String        @map("customer_order_id") @db.Uuid
  eventCode       String        @map("event_code")
  fromStatusCode  String?       @map("from_status_code")
  toStatusCode    String?       @map("to_status_code")
  note            String?
