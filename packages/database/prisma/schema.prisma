  rowVersion            BigInt    @default(1) @map("row_version")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId       String    @map("created_by_user_id") @db.Uuid
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId       String    @map("updated_by_user_id") @db.Uuid

  @@index([erpOrderId, createdAt, id])
  @@index([customerOrderId, createdAt])
  @@index([countryCode, expectedDeliveryDate])
  @@index([countryCode, milestoneCode, updatedAt, id])
  @@map("shipments")
}

