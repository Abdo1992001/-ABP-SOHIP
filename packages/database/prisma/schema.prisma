model Opportunity {
  id                    String                           @id @default(uuid()) @map("opportunity_id") @db.Uuid
  opportunityRef        String                           @unique @default(dbgenerated("('OPP-'::text || lpad((nextval('opportunity_ref_seq'::regclass))::text, 8, '0'::text))")) @map("opportunity_ref")
  /// What the deal is called. Nullable only because rows created before the
  /// column existed were backfilled from their project or customer; a new
  /// opportunity is required to carry one.
  title                 String?
  /// Cancelled is not lost: the customer dropped the requirement, rather than
  /// a competitor winning it, so it must not land in win/loss analysis.
  cancelledAt           DateTime?                        @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason    String?                          @map("cancellation_reason")
  accountId             String                           @map("account_id") @db.Uuid
  projectId             String?                          @map("project_id") @db.Uuid
  countryCode           String                           @map("country_code") @db.Char(2)
  ownerUserId           String                           @map("owner_user_id") @db.Uuid
  stageCode             String                           @map("stage_code")
  probabilityPct        Decimal?                         @map("probability_pct") @db.Decimal(5, 2)
  probabilitySourceCode String                           @default("STAGE_DEFAULT") @map("probability_source_code")
  estimatedValue        Decimal?                         @map("estimated_value") @db.Decimal(18, 2)
  currencyCode          String?                          @map("currency_code") @db.Char(3)
  expectedCloseDate     DateTime?                        @map("expected_close_date") @db.Date
  noProjectReasonCode   String?                          @map("no_project_reason_code")
  lostReasonCode        String?                          @map("lost_reason_code")
  wonAt                 DateTime?                        @map("won_at") @db.Timestamptz(6)
  wonValueSnapshot      Decimal?                         @map("won_value_snapshot") @db.Decimal(18, 2)
  rowVersion            BigInt                           @default(1) @map("row_version")
  createdAt             DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId       String                           @map("created_by_user_id") @db.Uuid
  updatedAt             DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId       String                           @map("updated_by_user_id") @db.Uuid
  account               Account                          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  project               Project?                         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  owner                 AppUser                          @relation("OpportunityOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy             AppUser                          @relation("OpportunityCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy             AppUser                          @relation("OpportunityUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  transitions           OpportunityStageTransition[]
  probabilityOverrides  OpportunityProbabilityOverride[]
  wonSnapshots          OpportunityWonSnapshot[]
  country               Country                          @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  quotations            Quotation[]

  @@index([countryCode, stageCode, updatedAt(sort: Desc), id], map: "opportunities_country_stage_updated_idx")
  @@index([accountId, stageCode], map: "opportunities_account_stage_idx")
  @@index([projectId])
  @@index([title], map: "opportunities_title_idx")
  @@map("opportunities")
}

