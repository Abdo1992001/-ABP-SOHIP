  quotationLineId String?       @map("quotation_line_id") @db.Uuid
  lineNo          Int           @map("line_no")
  productId       String?       @map("product_id") @db.Uuid
  itemCode        String?       @map("item_code")
  description     String
  quantity        Decimal       @db.Decimal(18, 4)
  unitCode        String        @map("unit_code")
  unitPrice       Decimal       @map("unit_price") @db.Decimal(18, 4)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(18, 4)
  lineTotal       Decimal       @map("line_total") @db.Decimal(18, 4)
  weightKg        Decimal?      @map("weight_kg") @db.Decimal(18, 3)
  order           CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)

  @@unique([customerOrderId, lineNo])
