generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  code                String              @id @db.Char(2)
  name                String
  continentCode       String              @map("continent_code")
  active              Boolean             @default(true)
  userAccess          UserCountryAccess[]
  accounts            Account[]           @relation("AccountCountry")
  accountHeadquarters Account[]           @relation("AccountHqCountry")
  projects            Project[]
  opportunities       Opportunity[]

  @@map("countries")
}

model AppUser {
  id                          String                    @id @default(uuid()) @db.Uuid
  externalSubject             String                    @unique @map("external_subject")
  usernameNormalized          String?                   @unique @map("username_normalized")
  displayName                 String                    @map("display_name")
  emailNormalized             String                    @unique @map("email_normalized")
  authStatusCode              String                    @default("ACTIVE") @map("auth_status_code")
  authProvider                String                    @default("SSO") @map("auth_provider")
  passwordHash                String?                   @map("password_hash")
  failedLoginCount            Int                       @default(0) @map("failed_login_count")
  lockedUntil                 DateTime?                 @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt           DateTime?                 @map("password_changed_at") @db.Timestamptz(6)
  mustChangePassword          Boolean                   @default(false) @map("must_change_password")
  mfaRequired                 Boolean                   @default(false) @map("mfa_required")
  mfaEnabled                  Boolean                   @default(false) @map("mfa_enabled")
  mfaSecretCiphertext         String?                   @map("mfa_secret_ciphertext")
  mfaSecretIv                 String?                   @map("mfa_secret_iv")
  mfaSecretAuthTag            String?                   @map("mfa_secret_auth_tag")
  mfaSecretVersion            Int?                      @map("mfa_secret_version")
  lastSignInAt                DateTime?                 @map("last_sign_in_at") @db.Timestamptz(6)
  rowVersion                  BigInt                    @default(1) @map("row_version")
  active                      Boolean                   @default(true)
  policyVersion               Int                       @default(1) @map("policy_version")
  createdAt                   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  countries                   UserCountryAccess[]
  roles                       UserRole[]
  profile                     UserProfile?              @relation("UserProfileOwner")
  managedProfiles             UserProfile[]             @relation("UserProfileManager")
  permissionOverrides         UserPermissionOverride[]
  sessions                    AppSession[]
  authChallenges              AuthChallenge[]
  mfaRecoveryCodes            MfaRecoveryCode[]
  createdConversations        Conversation[]            @relation("ConversationCreator")
  conversationMemberships     ConversationParticipant[]
  sentMessages                Message[]                 @relation("MessageSender")
  messageReactions            MessageReaction[]
  uploadedMessageAttachments  MessageAttachment[]       @relation("MessageAttachmentUploader")
  ownedAccounts               Account[]                 @relation("AccountOwner")
  createdAccounts             Account[]                 @relation("AccountCreatedBy")
  updatedAccounts             Account[]                 @relation("AccountUpdatedBy")
  archivedAccounts            Account[]                 @relation("AccountArchivedBy")
  receivedCustomerShares      CustomerShare[]           @relation("CustomerShareRecipient")
  customerShareOwnerSnapshots CustomerShare[]           @relation("CustomerShareOwnerSnapshot")
  createdCustomerShares       CustomerShare[]           @relation("CustomerShareCreatedBy")
  revokedCustomerShares       CustomerShare[]           @relation("CustomerShareRevokedBy")
  createdGroupMemberships     AccountGroupMembership[]  @relation("GroupMembershipCreatedBy")
  createdContacts             Contact[]                 @relation("ContactCreatedBy")
  updatedContacts             Contact[]                 @relation("ContactUpdatedBy")
  receivedContactShares       ContactShare[]            @relation("ContactShareRecipient")
  createdContactShares        ContactShare[]            @relation("ContactShareCreatedBy")
  revokedContactShares        ContactShare[]            @relation("ContactShareRevokedBy")
  commercialOwnedProjects     Project[]                 @relation("ProjectCommercialOwner")
  createdProjects             Project[]                 @relation("ProjectCreatedBy")
  updatedProjects             Project[]                 @relation("ProjectUpdatedBy")
  archivedProjects            Project[]                 @relation("ProjectArchivedBy")
  ownedOpportunities          Opportunity[]             @relation("OpportunityOwner")
  createdOpportunities        Opportunity[]             @relation("OpportunityCreatedBy")
  updatedOpportunities        Opportunity[]             @relation("OpportunityUpdatedBy")
  createdProducts             Product[]                 @relation("ProductCreatedBy")
  productImages               ProductImage[]            @relation("ProductImageUploader")
  updatedProducts             Product[]                 @relation("ProductUpdatedBy")
  archivedProducts            Product[]                 @relation("ProductArchivedBy")
  ownedQuotations             Quotation[]               @relation("QuotationOwner")
  createdQuotations           Quotation[]               @relation("QuotationCreatedBy")
  updatedQuotations           Quotation[]               @relation("QuotationUpdatedBy")
  commandIdempotencyRecords   CommandIdempotency[]
  createdDocumentSubjects     DocumentSubject[]         @relation("DocumentSubjectCreatedBy")
  requestedToolJobs           ToolJob[]                 @relation("ToolJobRequestedBy")

  @@map("app_users")
}

model UserCountryAccess {
  userId      String    @map("user_id") @db.Uuid
  countryCode String    @map("country_code") @db.Char(2)
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedBy   String    @map("granted_by") @db.Uuid
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo     DateTime? @map("valid_to") @db.Timestamptz(6)
  statusCode  String    @default("ACTIVE") @map("status_code")
  user        AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  country     Country   @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  @@id([userId, countryCode])
  @@index([countryCode])
  @@index([userId, statusCode, validFrom, validTo], map: "user_country_access_effective_idx")
  @@map("user_country_access")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  name            String
  workspace       String
  active          Boolean          @default(true)
  systemProtected Boolean          @default(false) @map("is_system_protected")
  rowVersion      BigInt           @default(1) @map("row_version")
  permissions     RolePermission[]
  users           UserRole[]

  @@map("roles")
}

model Permission {
  id          String                   @unique @default(uuid()) @map("permission_id") @db.Uuid
  code        String                   @id
  description String
  roles       RolePermission[]
  overrides   UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code")
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Generic governed contract for NEW external/engineering tool integrations
/// (e.g. ACROW Board Planner, Cargo Loader) — does not replace the existing
/// per-domain pipelines (ImportBatch, ReconciliationRun, CapacityEstimateRun,
/// LogisticsOptimizerRun), which stay as-is. Input is snapshotted, output is
/// structured JSON plus an optional artifact, and applying results to
/// canonical data (e.g. QuotationLine) is a separate, explicit, audited step
/// — a tool never writes commercial records directly.
model ToolJob {
  id                 String            @id @default(uuid()) @db.Uuid
  toolTypeCode       String            @map("tool_type_code")
  requestedByUserId  String            @map("requested_by_user_id") @db.Uuid
  accountId          String?           @map("account_id") @db.Uuid
  projectId          String?           @map("project_id") @db.Uuid
  quotationId        String?           @map("quotation_id") @db.Uuid
  inputSnapshot      Json              @map("input_snapshot")
  inputHash          String            @map("input_hash")
  statusCode         String            @default("QUEUED") @map("status_code")
  progress           Int               @default(0)
  structuredResult   Json?             @map("structured_result")
  artifactDocumentId String?           @map("artifact_document_id") @db.Uuid
  warnings           Json?
  errors             Json?
  errorMessage       String?           @map("error_message")
  reviewedByUserId   String?           @map("reviewed_by_user_id") @db.Uuid
  approvedAt         DateTime?         @map("approved_at") @db.Timestamptz(6)
  appliedAt          DateTime?         @map("applied_at") @db.Timestamptz(6)
  startedAt          DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(6)
  rowVersion         BigInt            @default(1) @map("row_version")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  requestedBy        AppUser           @relation("ToolJobRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  account            Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  project            Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quotation          Quotation?        @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  artifactDocument   DocumentMetadata? @relation(fields: [artifactDocumentId], references: [id], onDelete: SetNull)

  @@index([toolTypeCode, statusCode])
  @@index([accountId])
  @@index([projectId])
  @@index([quotationId])
  @@map("tool_jobs")
}

/// A public "request access" submission. Never creates an AppUser or grants
/// any access by itself — an admin with `users.create` must review and
/// approve it, which is what actually provisions the account.
model AccessRequest {
  id               String    @id @default(uuid()) @db.Uuid
  fullName         String    @map("full_name")
  workEmail        String    @map("work_email")
  companyOrRole    String?   @map("company_or_role")
  countryCode      String?   @map("country_code") @db.Char(2)
  message          String?
  statusCode       String    @default("PENDING") @map("status_code")
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason  String?   @map("rejection_reason")
  createdUserId    String?   @map("created_user_id") @db.Uuid
  rowVersion       BigInt    @default(1) @map("row_version")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([statusCode, createdAt])
  @@map("access_requests")
}

model UserProfile {
  userId        String  @id @map("user_id") @db.Uuid
  displayName   String  @map("display_name")
  jobTitle      String? @map("job_title")
  managerUserId String? @map("manager_user_id") @db.Uuid
  teamId        String? @map("team_id") @db.Uuid
  phone         String?

  /// The photo lives in the object store; these are only its reference.
  /// photoUpdatedAt doubles as the cache buster on the served URL.
  photoStorageKey  String?   @map("photo_storage_key")
  photoContentType String?   @map("photo_content_type")
  photoSizeBytes   Int?      @map("photo_size_bytes")
  photoSha256      String?   @map("photo_sha256")
  photoUpdatedAt   DateTime? @map("photo_updated_at") @db.Timestamptz(6)

  /// What colleagues see. Only optional personal information has a switch:
  /// name, role and email are business identity and always visible.
  photoVisible Boolean  @default(true) @map("photo_visible")
  phoneVisible Boolean  @default(true) @map("phone_visible")
  user         AppUser  @relation("UserProfileOwner", fields: [userId], references: [id], onDelete: Restrict)
  manager      AppUser? @relation("UserProfileManager", fields: [managerUserId], references: [id], onDelete: Restrict)

  @@index([managerUserId, userId])
  @@map("user_profiles")
}

model UserPermissionOverride {
  id             String     @id @default(uuid()) @map("override_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  permissionCode String     @map("permission_code")
  effectCode     String     @map("effect_code")
  validFrom      DateTime   @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo        DateTime?  @map("valid_to") @db.Timestamptz(6)
  reason         String
  user           AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@index([userId, permissionCode, effectCode], map: "user_permission_overrides_user_permission_effect_idx")
  @@map("user_permission_overrides")
}

/// Persisted application-session truth. Production BFF/Entra issuance is deferred,
/// but authorization never trusts a client session identifier without this record.
model AppSession {
  id                    String    @id @map("session_id")
  userId                String    @map("user_id") @db.Uuid
  tokenHash             String?   @unique @map("token_hash")
  csrfTokenHash         String?   @map("csrf_token_hash")
  statusCode            String    @default("ACTIVE") @map("status_code")
  privileged            Boolean   @default(false)
  policyVersionSnapshot Int       @default(1) @map("policy_version_snapshot")
  issuedAt              DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  authTime              DateTime  @default(now()) @map("auth_time") @db.Timestamptz(6)
  lastSeenAt            DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  absoluteExpiresAt     DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP + '12:00:00'::interval)")) @map("absolute_expires_at") @db.Timestamptz(6)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId       String?   @map("revoked_by_user_id") @db.Uuid
  user                  AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, statusCode, expiresAt], map: "app_sessions_user_status_expiry_idx")
  @@map("app_sessions")
}

model AuthChallenge {
  id           String    @id @default(uuid()) @map("challenge_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  typeCode     String    @default("LOGIN_MFA") @map("type_code")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, typeCode, expiresAt])
  @@map("auth_challenges")
}

model Conversation {
  id                  String                    @id @default(uuid()) @map("conversation_id") @db.Uuid
  typeCode            String                    @map("type_code")
  title               String?
  createdByUserId     String                    @map("created_by_user_id") @db.Uuid
  businessContextType String?                   @map("business_context_type")
  businessContextId   String?                   @map("business_context_id") @db.Uuid
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           AppUser                   @relation("ConversationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  participants        ConversationParticipant[]
  messages            Message[]
  attachments         MessageAttachment[]

  @@unique([businessContextType, businessContextId], map: "conversations_business_context_key")
  @@index([updatedAt, id])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleCode       String       @default("MEMBER") @map("role_code")
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime?    @map("left_at") @db.Timestamptz(6)
  lastReadAt     DateTime?    @map("last_read_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, leftAt, conversationId])
  @@map("conversation_participants")
}

model Message {
  id               String              @id @default(uuid()) @map("message_id") @db.Uuid
  conversationId   String              @map("conversation_id") @db.Uuid
  senderUserId     String              @map("sender_user_id") @db.Uuid
  replyToMessageId String?             @map("reply_to_message_id") @db.Uuid
  body             String
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  editedAt         DateTime?           @map("edited_at") @db.Timestamptz(6)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)
  conversation     Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           AppUser             @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  replyTo          Message?            @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]           @relation("MessageReply")
  reactions        MessageReaction[]
  attachments      MessageAttachment[]

  @@index([conversationId, createdAt, id])
  @@index([replyToMessageId])
  @@map("messages")
}

model MessageReaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@map("message_reactions")
}

model MessageAttachment {
  id             String       @id @default(uuid()) @map("attachment_id") @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  messageId      String?      @map("message_id") @db.Uuid
  uploadedById   String       @map("uploaded_by_user_id") @db.Uuid
  storageKey     String       @unique @map("storage_key")
  fileName       String       @map("file_name")
  contentType    String       @map("content_type")
  sizeBytes      Int          @map("size_bytes")
  sha256         String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy     AppUser      @relation("MessageAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([conversationId, messageId])
  @@map("message_attachments")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @map("recovery_code_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

/// Shared, PostgreSQL-backed limiter state so limits remain correct with multiple API replicas.
model RequestRateLimit {
  bucketKey    String   @id @map("bucket_key")
  requestCount Int      @default(0) @map("request_count")
  windowStart  DateTime @map("window_start") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "request_rate_limits_expiry_idx")
  @@map("request_rate_limits")
}

model Account {
  id                     String                   @id @default(uuid()) @map("account_id") @db.Uuid
  accountRef             String                   @unique @default(dbgenerated("('ACC-'::text || lpad((nextval('account_ref_seq'::regclass))::text, 8, '0'::text))")) @map("account_ref")
  customerNumber         String?                  @map("customer_number")
  rawName                String?                  @map("raw_name")
  canonicalName          String                   @map("canonical_name")
  normalizedName         String                   @map("normalized_name")
  countryCode            String                   @map("country_code") @db.Char(2)
  hqCountryCode          String?                  @map("hq_country_code") @db.Char(2)
  accountCategoryCode    String?                  @map("account_category_code")
  businessTypeCode       String                   @default("OTHER") @map("business_type_code")
  relationshipTypeCode   String                   @default("EXTERNAL_CUSTOMER") @map("relationship_type_code")
  groupParentName        String?                  @map("group_parent_name")
  /// Postal address, as printed on the buyer block of a proforma invoice.
  address                String?
  /// A place pinned on the map; without one the map uses the address or country.
  latitude               Float?
  longitude              Float?
  /// Tax registration number — NIP in Poland, its equivalent elsewhere.
  taxNumber              String?                  @map("tax_number")
  sourceImportBatchId    String?                  @map("source_import_batch_id") @db.Uuid
  sourceRowNo            BigInt?                  @map("source_row_no")
  ownerUserId            String                   @map("owner_user_id") @db.Uuid
  defaultCurrencyCode    String?                  @map("default_currency_code") @db.Char(3)
  sourceSystemId         String?                  @map("source_system_id") @db.Uuid
  sourceRecordKey        String?                  @map("source_record_key")
  recordStatusCode       String                   @default("ACTIVE") @map("record_status_code")
  archivedAt             DateTime?                @map("archived_at") @db.Timestamptz(6)
  archivedByUserId       String?                  @map("archived_by_user_id") @db.Uuid
  rowVersion             BigInt                   @default(1) @map("row_version")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId        String?                  @map("created_by_user_id") @db.Uuid
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId        String?                  @map("updated_by_user_id") @db.Uuid
  country                Country                  @relation("AccountCountry", fields: [countryCode], references: [code], onDelete: Restrict)
  hqCountry              Country?                 @relation("AccountHqCountry", fields: [hqCountryCode], references: [code], onDelete: Restrict)
  owner                  AppUser                  @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy              AppUser?                 @relation("AccountCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy              AppUser?                 @relation("AccountUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  archivedBy             AppUser?                 @relation("AccountArchivedBy", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  shares                 CustomerShare[]
  contacts               Contact[]
  contactShares          ContactShare[]
  groupMemberships       AccountGroupMembership[]
  projectParties         ProjectParty[]
  opportunities          Opportunity[]
  activities             Activity[]
  quotations             Quotation[]
  erpOrders              ERPOrder[]
  payments               Payment[]
  cheques                Cheque[]
  returnedScrapRequests  ReturnedScrapRequest[]
  complaints             Complaint[]
  customerOrders         CustomerOrder[]
  receivableInstallments ReceivableInstallment[]
  workOrders             WorkOrder[]
  customerFeedback       CustomerFeedback[]
  repeatBusinessRequests RepeatBusinessRequest[]
  toolJobs               ToolJob[]

  @@index([ownerUserId, recordStatusCode, updatedAt(sort: Desc), id], map: "accounts_owner_status_updated_id_idx")
  @@index([countryCode, ownerUserId], map: "accounts_country_owner_idx")
  @@index([businessTypeCode, recordStatusCode], map: "accounts_business_type_status_idx")
  @@index([normalizedName])
  @@index([customerNumber])
  @@map("accounts")
}

model Product {
  id                     String          @id @default(uuid()) @map("product_id") @db.Uuid
  productRef             String          @unique @default(dbgenerated("('PRD-'::text || lpad((nextval('product_ref_seq'::regclass))::text, 8, '0'::text))")) @map("product_ref")
  skuCode                String?         @unique @map("sku_code")
  barcode                String?         @unique
  productFamilyId        String          @map("product_family_id") @db.Uuid
  productTypeCode        String          @map("product_type_code")
  itemClassificationCode String          @default("SELLABLE_PRODUCT") @map("item_classification_code")
  productStatusCode      String          @default("ACTIVE") @map("product_status_code")
  itemClassRaw           String?         @map("item_class_raw")
  subCategory            String?         @map("sub_category")
