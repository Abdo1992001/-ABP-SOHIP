  @@map("customer_order_events")
}

/// What a customer order still owes, one row per installment of the payment
/// schedule the customer accepted. Due dates of "after delivery" installments
/// are set at hand-over; until then they are not yet due.
model ReceivableInstallment {
  id                 String              @id @default(uuid()) @map("receivable_installment_id") @db.Uuid
  customerOrderId    String              @map("customer_order_id") @db.Uuid
  accountId          String              @map("account_id") @db.Uuid
  countryCode        String              @map("country_code") @db.Char(2)
  currencyCode       String              @map("currency_code") @db.Char(3)
  installmentNo      Int                 @map("installment_no")
  label              String
  stageCode          String              @map("stage_code")
  dueBasisCode       String              @map("due_basis_code")
  daysAfter          Int?                @map("days_after")
  dueDate            DateTime?           @map("due_date") @db.Date
  amount             Decimal             @db.Decimal(18, 4)
  collectedAmount    Decimal             @default(0) @map("collected_amount") @db.Decimal(18, 4)
  writtenOffAmount   Decimal             @default(0) @map("written_off_amount") @db.Decimal(18, 4)
  methodCode         String?             @map("method_code")
  statusCode         String              @default("OPEN") @map("status_code")
  writeOffReason     String?             @map("write_off_reason")
  writtenOffAt       DateTime?           @map("written_off_at") @db.Timestamptz(6)
  writtenOffByUserId String?             @map("written_off_by_user_id") @db.Uuid
  rowVersion         BigInt              @default(1) @map("row_version")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order              CustomerOrder       @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  account            Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  receipts           ReceivableReceipt[]

  @@unique([customerOrderId, installmentNo])
  @@index([countryCode, statusCode, dueDate])
  @@index([accountId, dueDate])
  @@map("receivable_installments")
}

/// The factory's side of a customer order: a run of boards on a line, for
/// planned days computed from the category's capacity rate.
model WorkOrder {
  id                   String           @id @default(uuid()) @map("work_order_id") @db.Uuid
  workOrderRef         String           @unique @default(dbgenerated("('WO-'::text || lpad((nextval('work_order_ref_seq'::regclass))::text, 6, '0'::text))")) @map("work_order_ref")
  customerOrderId      String           @map("customer_order_id") @db.Uuid
  accountId            String           @map("account_id") @db.Uuid
  countryCode          String           @map("country_code") @db.Char(2)
  statusCode           String           @default("PLANNED") @map("status_code")
  productionLineCode   String           @map("production_line_code")
  capacityCategoryCode String           @map("capacity_category_code")
  boardsPerDaySnapshot Int?             @map("boards_per_day_snapshot")
  quantityPlanned      Decimal          @map("quantity_planned") @db.Decimal(18, 4)
  quantityProduced     Decimal          @default(0) @map("quantity_produced") @db.Decimal(18, 4)
  quantityRejected     Decimal          @default(0) @map("quantity_rejected") @db.Decimal(18, 4)
  plannedStartDate     DateTime         @map("planned_start_date") @db.Date
  plannedEndDate       DateTime         @map("planned_end_date") @db.Date
  actualStartAt        DateTime?        @map("actual_start_at") @db.Timestamptz(6)
  actualEndAt          DateTime?        @map("actual_end_at") @db.Timestamptz(6)
  priorityCode         String           @default("NORMAL") @map("priority_code")
  notes                String?
  qcResultCode         String?          @map("qc_result_code")
  qcNotes              String?          @map("qc_notes")
  qcByUserId           String?          @map("qc_by_user_id") @db.Uuid
  qcAt                 DateTime?        @map("qc_at") @db.Timestamptz(6)
  holdReason           String?          @map("hold_reason")
  cancelReason         String?          @map("cancel_reason")
  createdByUserId      String           @map("created_by_user_id") @db.Uuid
  rowVersion           BigInt           @default(1) @map("row_version")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order                CustomerOrder    @relation(fields: [customerOrderId], references: [id], onDelete: Restrict)
  account              Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  events               WorkOrderEvent[]

  @@index([customerOrderId, createdAt])
  @@index([countryCode, plannedStartDate, plannedEndDate])
  @@map("work_orders")
}

model WorkOrderEvent {
  id             String    @id @default(uuid()) @map("work_order_event_id") @db.Uuid
  workOrderId    String    @map("work_order_id") @db.Uuid
  eventCode      String    @map("event_code")
  fromStatusCode String?   @map("from_status_code")
  toStatusCode   String?   @map("to_status_code")
  note           String?
  details        Json?
  actorUserId    String    @map("actor_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId, createdAt])
  @@map("work_order_events")
}

/// Feedback a customer gave on the public page, without an account, matched
/// by the reference they gave to their account and salesperson.
model CustomerFeedback {
  id                   String    @id @default(uuid()) @map("feedback_id") @db.Uuid
  feedbackRef          String    @unique @default(dbgenerated("('FB-'::text || lpad((nextval('customer_feedback_ref_seq'::regclass))::text, 6, '0'::text))")) @map("feedback_ref")
  kindCode             String    @map("kind_code")
  topicCode            String    @default("OTHER") @map("topic_code")
  rating               Int?      @db.SmallInt
  isCritical           Boolean   @default(false) @map("is_critical")
  referenceTypeCode    String    @map("reference_type_code")
  referenceText        String    @map("reference_text")
  accountId            String?   @map("account_id") @db.Uuid
  customerOrderId      String?   @map("customer_order_id") @db.Uuid
  quotationId          String?   @map("quotation_id") @db.Uuid
  productId            String?   @map("product_id") @db.Uuid
  salespersonUserId    String?   @map("salesperson_user_id") @db.Uuid
  countryCode          String?   @map("country_code") @db.Char(2)
  contactName          String    @map("contact_name")
  companyName          String?   @map("company_name")
  jobTitle             String?   @map("job_title")
  phone                String?
  email                String?
  preferredChannelCode String?   @map("preferred_channel_code")
  consentToContact     Boolean   @default(true) @map("consent_to_contact")
  message              String
  statusCode           String    @default("NEW") @map("status_code")
  complaintId          String?   @map("complaint_id") @db.Uuid
  followUpNote         String?   @map("follow_up_note")
  followedUpByUserId   String?   @map("followed_up_by_user_id") @db.Uuid
  followedUpAt         DateTime? @map("followed_up_at") @db.Timestamptz(6)
  sourceHash           String?   @map("source_hash")
  rowVersion           BigInt    @default(1) @map("row_version")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  account              Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([salespersonUserId, statusCode, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
  @@index([statusCode, createdAt(sort: Desc)])
  @@map("customer_feedback")
}

model ReceivableReceipt {
  id               String                @id @default(uuid()) @map("receivable_receipt_id") @db.Uuid
  installmentId    String                @map("receivable_installment_id") @db.Uuid
  paymentId        String                @map("payment_id") @db.Uuid
  amount           Decimal               @db.Decimal(18, 4)
  receivedOn       DateTime              @map("received_on") @db.Date
  methodCode       String                @map("method_code")
  reference        String?
  note             String?
  recordedByUserId String                @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  installment      ReceivableInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([installmentId, receivedOn])
  @@map("receivable_receipts")
}

/// Alerts already sent, by a key naming what they were about and when it fell
/// due, so the scanner announces each late thing once.
model AlertLog {
  alertKey         String   @id @map("alert_key")
  typeCode         String   @map("type_code")
  resourceTypeCode String   @map("resource_type_code")
  resourceId       String   @map("resource_id") @db.Uuid
  recipients       Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resourceTypeCode, resourceId])
  @@map("alert_log")
}
