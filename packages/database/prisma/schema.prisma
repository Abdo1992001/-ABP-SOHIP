model Quotation {
  id                         String                @id @default(uuid()) @map("quotation_id") @db.Uuid
  quotationRef               String                @unique @default(dbgenerated("next_quotation_ref()")) @map("quotation_ref")
  accountId                  String                @map("account_id") @db.Uuid
  opportunityId              String                @map("opportunity_id") @db.Uuid
  projectId                  String?               @map("project_id") @db.Uuid
  contactId                  String?               @map("contact_id") @db.Uuid
  countryCode                String                @map("country_code") @db.Char(2)
  ownerUserId                String                @map("owner_user_id") @db.Uuid
  documentTypeCode           String                @default("QUOTATION") @map("document_type_code")
  incotermCode               String?               @map("incoterm_code")
  statusCode                 String                @default("DRAFT") @map("status_code")
  commercialStateCode        String                @default("NOT_SUBMITTED") @map("commercial_state_code")
  firstSubmittedAt           DateTime?             @map("first_submitted_at") @db.Timestamptz(6)
  currencyCode               String?               @map("currency_code") @db.Char(3)
  paymentTermsCode           String?               @map("payment_terms_code")
  customPaymentTerms         String?               @map("custom_payment_terms")
  paymentTermsSnapshot       String?               @map("payment_terms_snapshot")
  paymentScheduleJson        Json?                 @map("payment_schedule_jsonb")
  // Quotation-level pricing overrides — apply to all lines of that material
  // class unless an individual line overrides further (item override).
  // Never company defaults: see apps/api/src/quotation/pricing-hierarchy.ts.
  standardPricePerKgOverride Decimal?              @map("standard_price_per_kg_override") @db.Decimal(18, 8)
  curvedPricePerKgOverride   Decimal?              @map("curved_price_per_kg_override") @db.Decimal(18, 8)
  circularPricePerKgOverride Decimal?              @map("circular_price_per_kg_override") @db.Decimal(18, 8)
  densityOverrideKgM3        Decimal?              @map("density_override_kg_m3") @db.Decimal(14, 4)
  fxRateId                   String?               @map("fx_rate_id") @db.Uuid
  fxRateSnapshot             Decimal?              @map("fx_rate_snapshot") @db.Decimal(18, 8)
  fxEffectiveAtSnapshot      DateTime?             @map("fx_effective_at_snapshot") @db.Timestamptz(6)
  calculationVersion         String                @default("v1") @map("calculation_version")
  validFrom                  DateTime?             @map("valid_from") @db.Date
  expiresOn                  DateTime?             @map("expires_on") @db.Date
  subtotalAmount             Decimal               @default(0) @map("subtotal_amount") @db.Decimal(18, 4)
  adjustmentAmount           Decimal               @default(0) @map("adjustment_amount") @db.Decimal(18, 4)
  taxAmount                  Decimal               @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount                Decimal               @default(0) @map("total_amount") @db.Decimal(18, 4)
  contentHash                String?               @map("content_hash")
  supersedesQuotationId      String?               @map("supersedes_quotation_id") @db.Uuid
  supersededAt               DateTime?             @map("superseded_at") @db.Timestamptz(6)
  /// Proforma invoice number, issued when the document is sent officially.
  piNumber                   String?               @unique @map("pi_number")
  piIssuedAt                 DateTime?             @map("pi_issued_at") @db.Timestamptz(6)
  /// What the offer is for, printed under the header. Chosen from the
  /// company-wide list in `DocumentSubject`, not typed free-hand.
  subject                    String?
  /// The customer's own purchase-order number, which their accounts
  /// department matches the invoice against.
  customerPoNumber           String?               @map("customer_po_number")
  /// How long after the order the goods ship, in the words the offer uses.
  leadTime                   String?               @map("lead_time")
  /// Freight and insurance in the quotation currency: EX-WORKS plus this
  /// is the CIF total a proforma states.
  freightAmount              Decimal?              @map("freight_amount") @db.Decimal(18, 4)
  /// Which shipping field matters depends on the incoterm: DDP uses the
  /// delivery address, CIF the port of discharge, FOB the port of loading.
  deliveryAddress            String?               @map("delivery_address")
  portOfLoading              String?               @map("port_of_loading")
  portOfDischarge            String?               @map("port_of_discharge")
  cancelledAt                DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason         String?               @map("cancellation_reason")
  sentAt                     DateTime?             @map("sent_at") @db.Timestamptz(6)
  rowVersion                 BigInt                @default(1) @map("row_version")
  createdAt                  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId            String                @map("created_by_user_id") @db.Uuid
  updatedAt                  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId            String                @map("updated_by_user_id") @db.Uuid
  account                    Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  opportunity                Opportunity           @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  project                    Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  owner                      AppUser               @relation("QuotationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy                  AppUser               @relation("QuotationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                  AppUser               @relation("QuotationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  supersedesQuotation        Quotation?            @relation("QuotationSupersession", fields: [supersedesQuotationId], references: [id], onDelete: Restrict)
  supersededBy               Quotation[]           @relation("QuotationSupersession")
  lines                      QuotationLine[]
  adjustments                QuotationAdjustment[]
  approvals                  QuotationApproval[]
  acceptances                QuotationAcceptance[]
  toolJobs                   ToolJob[]

  @@index([countryCode, statusCode, updatedAt(sort: Desc), id])
  @@index([accountId, statusCode])
  @@map("quotations")
}

